<?xml version="1.0" encoding="UTF-8"?>
<!--
  公共能力聚合模块（oj-common）
  - 不直接产出可运行 jar
  - 通过子模块拆分可复用能力（例如 redis、日志、鉴权工具、通用异常等）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>bite-oj</artifactId>
    <groupId>com.bite</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <artifactId>oj-common</artifactId>
  <packaging>pom</packaging>

  <modules>
    <!-- 通用核心能力（Result、LoginRedisKeys 等；需先于 oj-common-redis 构建） -->
    <module>oj-common-core</module>
    <!-- Redis 封装（依赖 core） -->
    <module>oj-common-redis</module>
    <!-- Elasticsearch 公共组件（连接配置、通用文档与仓储接口） -->
    <module>oj-common-elasticsearch</module>
    <!-- 文件存储公共组件（阿里云 OSS） -->
    <module>oj-common-file</module>
    <!-- 全局异常处理（ControllerAdvice + 统一返回 Result） -->
    <module>oj-common-security</module>
    <module>oj-common-swagger</module>
    <module>oj-common-MQ</module>
    <!-- 监控埋点 AOP（Micrometer，依赖方需已引入 actuator） -->
    <module>oj-common-AOP</module>
  </modules>
</project>

