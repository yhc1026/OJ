<?xml version="1.0" encoding="UTF-8"?>
<!--
  任务服务（oj-job）
  - 承载定时任务/异步任务/批处理等（后续可接入 XXL-JOB / Quartz 等）
  - 当前为可启动骨架与 /ping 验证接口
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>oj-modules</artifactId>
    <groupId>com.bite</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <artifactId>oj-job</artifactId>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <!-- Redis：spring-boot-starter-data-redis 由 oj-common-redis 传递引入 -->
    <dependency>
      <groupId>com.bite</groupId>
      <artifactId>oj-common-redis</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>

    <dependency>
      <groupId>com.bite</groupId>
      <artifactId>oj-common-AOP</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>

    <!-- MyBatis-Plus（已包含 MyBatis 核心与 Spring 集成，无需再单独加 mybatis-spring-boot-starter） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-boot-starter</artifactId>
      <version>3.5.3.1</version>
    </dependency>

    <!-- MySQL 驱动 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.xuxueli</groupId>
      <artifactId>xxl-job-core</artifactId>
      <version>2.4.0</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.32</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>

